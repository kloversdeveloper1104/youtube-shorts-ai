# ==================== YouTube Data API / OAuth ====================
# Google Cloud Console (https://console.cloud.google.com/) で
# 「YouTube Data API v3」と「YouTube Analytics API」を有効化し、
# OAuth 2.0 クライアントID(デスクトップアプリ)を作成して取得してください。
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
# 初回OAuth認証後、自動的に保存されます(手動入力不要)
YOUTUBE_REFRESH_TOKEN=

# ==================== Gemini API ====================
# https://aistudio.google.com/app/apikey で取得
GEMINI_API_KEY=
# モデル名は自由に変更可能(コード変更不要)
GEMINI_MODEL=gemini-3.5-flash-lite

# ==================== 音声合成(VoiceProvider) ====================
# デフォルトは無料のedge-tts(APIキー不要)。
# 有料プロバイダーに切り替える場合のみ設定。
VOICE_PROVIDER=edge-tts
VOICE_API_KEY=

# ==================== 映像素材(無料・推奨) ====================
# Pexels(https://www.pexels.com/api/)の無料APIキー。
# シーン内容に合う実写/イラスト写真を自動検索して動画に使用します(商用利用可・著作権表記不要)。
# 未設定の場合はFFmpegのグラデーション+テキストにフォールバックします。
PEXELS_API_KEY=

# ==================== 映像生成(VisualProvider, 任意・有料) ====================
# 未設定の場合はPEXELS_API_KEY、さらに未設定ならFFmpegのモーショングラフィックスにフォールバック
VIDEO_API_KEY=

# ==================== データベース ====================
DATABASE_URL="file:./dev.db"

# ==================== トークン暗号化 ====================
# 32文字以上のランダム文字列。初回起動時に自動生成することも可能。
TOKEN_ENCRYPTION_KEY=

# ==================== 運用設定 ====================
# OFF / SAFE / FULL (管理画面からも変更可能)
AUTO_MODE=OFF
AUTO_UPLOAD=false
QUALITY_THRESHOLD=85

# ==================== 通知(任意) ====================
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
