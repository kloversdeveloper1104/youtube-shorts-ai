# Node
node_modules/
.next/
out/
build/
dist/

# Env / secrets
.env
.env.local
.env.*.local
*.key
*.pem
credentials/

# OAuthトークン(暗号化キー含む)はリポジトリに絶対にコミットしない。
# CIはYOUTUBE_REFRESH_TOKENシークレットから直接読むため、tokens/自体は追跡不要。
tokens/

# GitHub Actions永続化用にprisma/dev.dbのみ追跡する(投稿履歴DB。機密情報は含まない)
prisma/dev.db-journal
*.db
!prisma/dev.db

# Storage (generated media, can be large)
storage/assets/*
storage/audio/*
storage/drafts/*
storage/completed/*
storage/uploaded/*
!storage/**/.gitkeep

# 例外: Content ID収益化対応BGM(TuneCore Creators/BGM LIBRARY由来)はCIでも
# 使う必要があるため追跡する(src/video/bgm.ts参照)
!storage/assets/bgm/
!storage/assets/bgm/*

# Logs
logs/*
!logs/.gitkeep
npm-debug.log*
*.log

# Claude Code local state
.claude/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts
