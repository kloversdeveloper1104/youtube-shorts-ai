# Node
node_modules/
.next/
out/
build/
dist/

# Env / secrets
.env
.env.local
.env.*.local
*.key
*.pem
credentials/

# GitHub Actions永続化用に tokens/ と prisma/dev.db は追跡する
# (CI実行間でOAuthトークンと投稿履歴DBを引き継ぐため。リポジトリはprivate運用が前提)
prisma/dev.db-journal
*.db
!prisma/dev.db

# Storage (generated media, can be large)
storage/assets/*
storage/audio/*
storage/drafts/*
storage/completed/*
storage/uploaded/*
!storage/**/.gitkeep

# Logs
logs/*
!logs/.gitkeep
npm-debug.log*
*.log

# Claude Code local state
.claude/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts
